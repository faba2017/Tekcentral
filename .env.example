ZEUS_ENABLED=true
ZEUS_PROVIDER=local
ZEUS_DIGITALOCEAN_BASE_URL=https://inference.do-ai.run
ZEUS_DIGITALOCEAN_API_KEY=
ZEUS_DIGITALOCEAN_MODEL=
ZEUS_GUEST_ENABLED=true
ZEUS_GUEST_MINUTE_LIMIT=5
ZEUS_GUEST_HOURLY_LIMIT=10
ZEUS_GUEST_DAILY_LIMIT=30
ZEUS_AUTH_MINUTE_LIMIT=10
ZEUS_AUTH_HOURLY_LIMIT=40
ZEUS_AUTH_DAILY_LIMIT=150
ZEUS_GLOBAL_MINUTE_LIMIT=120
# Optional global paid-inference safety ceiling. Blank means unlimited.
ZEUS_GLOBAL_DAILY_LIMIT=
ZEUS_COOLDOWN_SECONDS=30
ZEUS_DUPLICATE_WINDOW_SECONDS=8
# Server-only HMAC key used to pseudonymize quota identities at rest.
ZEUS_QUOTA_HASH_KEY=

PAYFAST_MERCHANT_ID=your-sandbox-merchant-id
PAYFAST_MERCHANT_KEY=your-sandbox-merchant-key
PAYFAST_PASSPHRASE=your-sandbox-passphrase
PAYFAST_MODE=sandbox
# Optional explicit profiles. Legacy PAYFAST_* credentials belong to PAYFAST_MODE.
PAYFAST_SANDBOX_MERCHANT_ID=
PAYFAST_SANDBOX_MERCHANT_KEY=
PAYFAST_SANDBOX_PASSPHRASE=
PAYFAST_LIVE_MERCHANT_ID=
PAYFAST_LIVE_MERCHANT_KEY=
PAYFAST_LIVE_PASSPHRASE=
PUBLIC_APP_URL=http://127.0.0.1:5173
PUBLIC_API_URL=http://127.0.0.1:8787
PAYFAST_TRUST_PROXY=false
HOST=127.0.0.1
PORT=8787
VITE_API_BASE_URL=http://127.0.0.1:8787
CJ_API_KEY=your-cj-api-key
CJ_REAL_ORDER_CREATION_ENABLED=false

VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_ADDRESS_VALIDATION_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Durable PostgreSQL order-confirmation worker. Set false only for an intentional worker hold.
CUSTOMER_DELIVERY_WORKER_ENABLED=true
# Prospective marker-aware commerce document repair. Explicit opt-in; never backfills historical Orders.
COMMERCE_RECONCILIATION_WORKER_ENABLED=false
COMMERCE_RECONCILIATION_POLL_MS=60000

OPERATIONS_NOTIFICATION_EMAIL=
FX_PRICING_NOTIFICATION_EMAIL=reports@tekcentral.co.za

APP_PUBLIC_BASE_URL=

# Syntech feed integration
SYNTECH_ENABLED=true

# Secret: full JSON feed URL from Syntech
SYNTECH_FULL_FEED_URL=

# Secret: update JSON feed URL from Syntech
SYNTECH_UPDATE_FEED_URL=
SYNTECH_RESELLER_API_ENABLED=false
SYNTECH_RESELLER_API_ENVIRONMENT=UAT
SYNTECH_RESELLER_UAT_TOKEN=
SYNTECH_RESELLER_UAT_BASE_URL=https://reseller.syntech.co.za/wp-json/uat-api/reseller/
# Production is intentionally unavailable during Syntech C.
SYNTECH_RESELLER_PROD_TOKEN=
SYNTECH_RESELLER_PROD_BASE_URL=

# Non-secret operational config
SYNTECH_FEED_FORMAT=json
SYNTECH_FULL_SYNC_INTERVAL_HOURS=24
SYNTECH_UPDATE_SYNC_INTERVAL_HOURS=1
# Public storefront origin used to construct customer password-reset links.
PUBLIC_STOREFRONT_ORIGIN=http://127.0.0.1:5173
# Production-required public Admin origin; this is configuration, not a secret.
ADMIN_ORIGIN=http://127.0.0.1:5173
# Development diagnostics only. Production startup rejects either flag when true.
PAYFAST_DEBUG_SIGNATURE=false
RECAPTCHA_TEST_BYPASS=false
# Production Admin host used by the Vite routing abstraction (no protocol).
VITE_ADMIN_HOST=

VITE_RECAPTCHA_SITE_KEY=your_public_site_key
RECAPTCHA_SECRET_KEY=your_private_secret_key
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=tekcentral.co.za,www.tekcentral.co.za

# One-time first staff account bootstrap. Remove the password after creation.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=
# Required in production for AES-256-GCM protection of staff TOTP secrets.
# Generate a random 32-byte value and store it only in backend secret management.
STAFF_2FA_ENCRYPTION_KEY=

# Persistence provider. LOCAL is for development/test only; staging/production require POSTGRES.
APP_ENV=development
# Use `web` for HTTP instances and `worker` for scheduled/background work.
# Browser/Admin requests cannot change this value. Initial production should use
# one worker replica; PostgreSQL advisory locks protect accidental overlap.
APP_ROLE=web
PERSISTENCE_PROVIDER=LOCAL
DATABASE_URL=
# Dedicated schema-owner/migration job identity. Never expose this URL to web or worker services.
DATABASE_MIGRATION_URL=
DATABASE_RUNTIME_ROLE=tekcentral_runtime
DATABASE_MIGRATION_ROLE=tekcentral_migration
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=10

# Object storage. LOCAL is for development/test only; staging/production require SPACES.
OBJECT_STORAGE_PROVIDER=LOCAL
OBJECT_STORAGE_LOCAL_ROOT=.data/object-storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_PUBLIC_BUCKET=
OBJECT_STORAGE_PRIVATE_BUCKET=
OBJECT_STORAGE_PUBLIC_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_SECRET_KEY=
OBJECT_STORAGE_PRIVATE_ACCESS_KEY=
OBJECT_STORAGE_PRIVATE_SECRET_KEY=
# Development/test compatibility only. Staging/production reject shared credentials.
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Syntech UAT API
SYNTECH_UAT_BASE_URL=https://reseller.syntech.co.za/wp-json/uat-api/reseller
SYNTECH_UAT_USERNAME=
SYNTECH_UAT_CREDENTIAL=

# Safety switch
# Keep false by default. Only enable during an explicitly approved UAT order-write test.
SYNTECH_UAT_ORDER_WRITES_ENABLED=false


# =========================================================
# TEKCENTRAL ADMIN AI
# =========================================================

ADMIN_AI_ENABLED=true
ADMIN_AI_PROVIDER=digitalocean
ADMIN_AI_DIGITALOCEAN_API_KEY=
ADMIN_AI_DIGITALOCEAN_PRIMARY_MODEL=glm-5.3
ADMIN_AI_DIGITALOCEAN_ROUTINE_MODEL=glm-5.3-flash
ADMIN_AI_DIGITALOCEAN_FALLBACK_MODEL=deepseek-v4.1-flash
# Dedicated worker/worker-role switch. Keep false on ordinary web instances.
ADMIN_AI_AUTOMATION_WORKER_ENABLED=false
